<div class="mx-auto max-w-3xl">
  <.header>
    Notifications
    <:actions>
      <%= if @notifications != [] do %>
        <.link
          href={~p"/notifications/mark_all_read"}
          method="post"
          class="text-sm font-semibold text-brand hover:underline"
        >
          Mark all as read
        </.link>
      <% end %>
    </:actions>
  </.header>

  <%= if @notifications == [] do %>
    <p class="mt-8 text-zinc-500">No unread notifications.</p>
  <% else %>
    <ul class="mt-6 space-y-3">
      <li
        :for={notification <- @notifications}
        class="flex items-center justify-between gap-4 rounded-lg border border-zinc-800 bg-zinc-900 p-4"
      >
        <div>
          <p class="text-sm text-zinc-200">
            <strong class="font-semibold text-zinc-100">{notification.actor.email}</strong>
            commented on
            <.link
              href={~p"/posts/#{notification.post}/comments"}
              class="font-semibold text-brand hover:underline"
            >
              {notification.post.title}
            </.link>
          </p>
          <span class="mt-1 block font-mono text-xs text-zinc-500">
            {Calendar.strftime(notification.inserted_at, "%B %d, %Y at %I:%M %p")}
          </span>
        </div>

        <.link
          href={~p"/notifications/#{notification.id}/mark_read"}
          method="post"
          class="flex-none rounded-md border border-zinc-700 px-3 py-1.5 text-xs font-medium text-zinc-300 transition-colors hover:border-brand hover:text-brand"
        >
          Mark as read
        </.link>
      </li>
    </ul>
  <% end %>
</div>
