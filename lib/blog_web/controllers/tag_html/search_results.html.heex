<div class="mx-auto max-w-3xl">
  <.header class="mb-2">
    Search Results
  </.header>

  <%= if @posts == [] do %>
    <p class="mt-8 text-zinc-500">No posts matched this tag.</p>
  <% else %>
    <ul class="mt-6 divide-y divide-zinc-800">
      <%= for post <- @posts do %>
        <BlogWeb.PostHTML.post_row post={post} current_user={@current_user} />
      <% end %>
    </ul>
  <% end %>

  <.back navigate={~p"/tags/search"}>Back to search</.back>
</div>
