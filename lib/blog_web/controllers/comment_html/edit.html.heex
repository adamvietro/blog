<div class="mx-auto max-w-lg">
  <.header>Edit Comment</.header>

  <.comment_form
    changeset={@changeset}
    id={@comment.id}
    action={~p"/posts/#{@comment.post_id}/comments/#{@comment.id}/edit"}
    post_id={@comment.post_id}
  />

  <.back navigate={~p"/posts/#{@comment.post_id}/comments/"}>Back to comments</.back>
</div>
