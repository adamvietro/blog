<div class="mx-auto max-w-3xl">
  <.header>
    Comments
    <:actions>
      <%= if assigns[:current_user] do %>
        <.link href={~p"/posts/#{@post.id}/comments/new"}>
          <.button>Add Comment</.button>
        </.link>
      <% else %>
        <.link href={~p"/users/log_in"} class="text-sm font-semibold text-brand hover:underline">
          Log in to comment
        </.link>
      <% end %>
    </:actions>
  </.header>

  <%= if @comments == [] do %>
    <p class="mt-8 text-zinc-500">No comments yet.</p>
  <% else %>
    <ul class="mt-6 space-y-4">
      <li :for={comment <- @comments} class="rounded-lg border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex items-start justify-between gap-4">
          <span class="font-mono text-xs text-zinc-500">{comment.user.email}</span>
          <%= if assigns[:current_user] && comment.user_id == assigns[:current_user].id do %>
            <span class="flex flex-none items-center gap-3 text-xs">
              <.link
                href={~p"/posts/#{comment.post_id}/comments/#{comment.id}/edit"}
                class="text-zinc-500 hover:text-brand"
              >
                Edit
              </.link>
              <.link
                href={~p"/posts/#{comment.post_id}/comments/#{comment.id}"}
                method="delete"
                data-confirm="Are you sure?"
                class="text-zinc-500 hover:text-red-400"
              >
                Delete
              </.link>
            </span>
          <% end %>
        </div>
        <p class="mt-2 text-sm text-zinc-700 dark:text-zinc-200">{comment.content}</p>
      </li>
    </ul>
  <% end %>

  <.back navigate={~p"/posts/#{@post.id}"}>Back to post</.back>
</div>
