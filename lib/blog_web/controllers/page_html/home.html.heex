<.flash_group flash={@flash} />

<section class="mx-auto max-w-5xl py-8 sm:py-16">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <p class="font-mono text-sm text-brand">$ whoami</p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
        Hey, I'm Adam. Welcome to my blog.
      </h1>

      <div class="prose mt-6">
        <p>
          A technical blog documenting my journey through the Elixir ecosystem —
          book notes, project deep-dives, and learnings from building real production
          applications. Posts cover Phoenix LiveView, distributed systems, functional
          programming, IoT with Nerves, and more.
        </p>
        <p>
          Browse by tag or search by title to find what interests you. Everything
          here reflects my commitment to clean, functional code and continuous learning.
          Whether you're a company, recruiter, or fellow developer, I invite you to
          explore my work and connect!
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <.link
          navigate={~p"/posts"}
          class="rounded-md bg-brand px-4 py-2 text-sm font-semibold text-zinc-950 transition-colors hover:bg-brand/90"
        >
          Read the posts
        </.link>
        <a
          href="https://github.com/adamvietro"
          target="_blank"
          rel="noopener"
          class="rounded-md border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-600 transition-colors hover:border-brand hover:text-brand dark:border-zinc-700 dark:text-zinc-300"
        >
          GitHub Profile
        </a>
        <a
          href="https://game-site.fly.dev/"
          target="_blank"
          rel="noopener"
          class="rounded-md border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-600 transition-colors hover:border-brand hover:text-brand dark:border-zinc-700 dark:text-zinc-300"
        >
          Game Site
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -inset-6 -z-10 rounded-3xl bg-brand/10 blur-3xl" aria-hidden="true">
      </div>
      <div class="rounded-lg border border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/40">
        <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-red-500/70"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/70"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/70"></span>
          <span class="ml-2 font-mono text-xs text-zinc-500">adam.ex</span>
        </div>
        <div class="space-y-1.5 p-6 font-mono text-sm leading-relaxed">
          <div>
            <span class="text-purple-400">defmodule</span>
            <span class="text-sky-300">Adam</span>
            <span class="text-purple-400">do</span>
          </div>
          <div class="pl-4 italic text-zinc-500"># always learning, always shipping</div>
          <div class="pl-4">
            <span class="text-purple-400">def</span>
            <span class="text-sky-300">status</span>,
            <span class="text-purple-400">do:</span>
            <span class="text-amber-300">:building</span>
          </div>
          <div>&nbsp;</div>
          <div class="pl-4">
            <span class="text-purple-400">def</span>
            <span class="text-sky-300">stack</span>
            <span class="text-purple-400">do</span>
          </div>
          <div class="pl-8">
            <span class="text-amber-300">~w</span><span class="text-zinc-500">(</span><span class="text-emerald-300">elixir phoenix liveview postgres</span><span class="text-zinc-500">)</span>
          </div>
          <div class="pl-4"><span class="text-purple-400">end</span></div>
          <div>
            <span class="text-purple-400">end</span>
            <span
              class="ml-1 inline-block h-4 w-[7px] translate-y-0.5 animate-pulse bg-brand"
              aria-hidden="true"
            >
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
