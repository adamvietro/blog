<div class="mx-auto max-w-3xl">
  <.header class="mb-2">
    Posts
    <:actions>
      <%= if @current_user && @current_user.admin do %>
        <.link href={~p"/posts/new"}>
          <.button>New Post</.button>
        </.link>
      <% end %>
    </:actions>
  </.header>

  <%= if @posts == [] do %>
    <p class="mt-8 text-zinc-500">No posts yet.</p>
  <% else %>
    <ul id="posts" class="mt-6 divide-y divide-zinc-800">
      <%= for post <- @posts do %>
        <.post_row post={post} current_user={@current_user} />
      <% end %>
    </ul>

    <%= if length(@posts) > 10 do %>
      <.load_more_button />
    <% end %>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    let posts = document.querySelectorAll("#posts > li");
    let loadMoreBtn = document.getElementById("load-more-btn");
    if (!loadMoreBtn) return;

    let visibleCount = 10;

    posts.forEach((post, index) => {
      if (index >= visibleCount) post.style.display = "none";
    });

    loadMoreBtn.addEventListener("click", function () {
      let hiddenPosts = Array.from(posts).filter(post => post.style.display === "none");

      hiddenPosts.slice(0, 10).forEach(post => (post.style.display = "flex"));

      if (hiddenPosts.length <= 10) loadMoreBtn.style.display = "none";
    });
  });
</script>
