<div class="mx-auto max-w-3xl">
  <.header class="mb-2">
    Posts
    <:actions>
      <%= if @current_user && @current_user.admin do %>
        <.link href={~p"/posts/new"}>
          <.button>New Post</.button>
        </.link>
      <% end %>
    </:actions>
  </.header>

  <%= if @posts == [] do %>
    <p class="mt-8 text-zinc-500">No posts yet.</p>
  <% else %>
    <ul id="posts" class="mt-6 divide-y divide-zinc-800">
      <%= for post <- @posts do %>
        <.post_row post={post} current_user={@current_user} />
      <% end %>
    </ul>

    <.pagination :if={Map.get(assigns, :total_pages)} page={@page} total_pages={@total_pages} />
  <% end %>
</div>
