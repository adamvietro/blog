<article class="mx-auto max-w-3xl">
  <.back navigate={~p"/posts"} class="mb-8">Back to posts</.back>

  <div :if={@post.tags != []} class="flex flex-wrap gap-1.5">
    <span
      :for={tag <- @post.tags}
      class="rounded-full bg-zinc-800/80 px-2 py-0.5 text-xs text-zinc-400"
    >
      {tag.name}
    </span>
  </div>

  <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-100 sm:text-4xl">
    {@post.title}
  </h1>

  <p class="mt-3 font-mono text-sm text-zinc-500">
    Published {@post.published_on}
  </p>

  <div :if={@post.cover_image && @post.cover_image.url} class="mt-8">
    <img
      src={@post.cover_image.url}
      class="max-h-[28rem] w-full rounded-lg border border-zinc-800 object-cover"
    />
  </div>

  <.markdown content={@post.content} />

  <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-zinc-800 pt-6">
    <%= if assigns[:current_user] && @post.user_id == assigns[:current_user].id do %>
      <.link href={~p"/posts/#{@post}/edit"}>
        <.button>Edit post</.button>
      </.link>
    <% end %>
    <.link href={~p"/posts/#{@post}/comments"}>
      <.button class="!bg-zinc-800 !text-zinc-200 hover:!bg-zinc-700">Comments</.button>
    </.link>
    <%= if assigns[:current_user] do %>
      <.link href={~p"/posts/#{@post}/comments/new"}>
        <.button class="!bg-zinc-800 !text-zinc-200 hover:!bg-zinc-700">Add Comment</.button>
      </.link>
    <% end %>
  </div>
</article>
