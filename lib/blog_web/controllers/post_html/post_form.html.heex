<.simple_form :let={f} for={@changeset} action={@action}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>
  <.input field={f[:title]} type="text" label="Title" />
  <div>
    <.input field={f[:content]} type="textarea" label="Content" rows="20" id="post-content-input" />
    <button
      type="button"
      id="content-preview-toggle"
      data-preview-url={~p"/posts/preview"}
      class="mt-1 text-xs font-semibold text-brand hover:underline"
    >
      Preview
    </button>
    <div
      id="content-preview"
      style="display: none"
      class="prose mt-2 rounded-lg border border-zinc-800 bg-zinc-900 p-4"
    >
    </div>
  </div>
  <div>
    <.input
      field={f[:published_on]}
      type="date"
      label="Published on"
      value={f.data.published_on || Date.utc_today()}
    />
    <p class="mt-1 text-xs text-zinc-500">
      A future date schedules the post — it stays hidden from everyone but admins until then.
    </p>
  </div>
  <.input field={f[:visibility]} type="checkbox" label="Visibility" />
  <div>
    <.input
      type="text"
      name="post[tag_names]"
      value={@tag_names}
      label="Tags"
      placeholder="elixir, phoenix, testing"
      list="tag-suggestions"
    />
    <datalist id="tag-suggestions">
      <option :for={tag <- @all_tags} value={tag.name} />
    </datalist>
    <p class="mt-1 text-xs text-zinc-500">Separate tags with commas.</p>
  </div>
  <.inputs_for :let={cover_image} field={f[:cover_image]}>
    <.input type="text" field={cover_image[:url]} label="Cover Image URL" />
  </.inputs_for>

  <:actions>
    <.button>Save Post</.button>
  </:actions>
</.simple_form>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const toggleBtn = document.getElementById("content-preview-toggle");
    const textarea = document.getElementById("post-content-input");
    const previewPane = document.getElementById("content-preview");
    if (!toggleBtn || !textarea || !previewPane) return;

    const csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    let previewing = false;

    toggleBtn.addEventListener("click", function () {
      if (previewing) {
        previewPane.style.display = "none";
        textarea.style.display = "";
        toggleBtn.textContent = "Preview";
        previewing = false;
        return;
      }

      fetch(toggleBtn.dataset.previewUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
          "x-csrf-token": csrfToken
        },
        body: "content=" + encodeURIComponent(textarea.value)
      })
        .then(function (response) { return response.text(); })
        .then(function (html) {
          previewPane.innerHTML = html;
          textarea.style.display = "none";
          previewPane.style.display = "block";
          toggleBtn.textContent = "Edit";
          previewing = true;
          if (window.Prism) window.Prism.highlightAll();
        })
        .catch(function () {
          alert("Couldn't load the preview. Please try again.");
        });
    });
  });
</script>
