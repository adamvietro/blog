<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="csrf-token" content={get_csrf_token()} />

<!-- Page Title -->
    <title>Blog | {Map.get(assigns, :page_title, "My Blog")}</title>

<!-- Basic Meta Description -->
    <meta name="description" content="Blog Site to keep track of my programming Journey." />

<!-- Author -->
    <meta name="author" content="Adam Vietro" />

<!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:title" content="Blog" />
    <meta property="og:description" content="Blog Site to keep track of my programming Journey." />
    <meta
      property="og:image"
      content="https://media2.dev.to/dynamic/image/width=1000,height=420,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.amazonaws.com%2Fuploads%2Farticles%2Fuuo9fxl96owi7avgzvhf.png"
    />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://blog-wild-leaf-1554.fly.dev/" />

<!-- Twitter Card -->
    <meta
      name="twitter:card"
      content="https://media2.dev.to/dynamic/image/width=1000,height=420,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.amazonaws.com%2Fuploads%2Farticles%2Fuuo9fxl96owi7avgzvhf.png"
    />
    <meta name="twitter:title" content="Blog" />
    <meta name="twitter:description" content="Blog Site to keep track of my programming Journey." />
    <meta
      name="twitter:image"
      content="https://media2.dev.to/dynamic/image/width=1000,height=420,fit=cover,gravity=auto,format=auto/https%3A%2F%2Fdev-to-uploads.s3.amazonaws.com%2Fuploads%2Farticles%2Fuuo9fxl96owi7avgzvhf.png"
    />

<!-- Optional: Article publish date -->
    <meta property="article:published_time" content="2025-03-01T00:00:00Z" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-200 antialiased">
    <header class="sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur">
      <div class="mx-auto flex w-full max-w-none flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4 sm:px-6 lg:px-8 xl:max-w-screen-xl 2xl:max-w-screen-2xl">
        <.link navigate={~p"/"} class="flex items-center gap-1.5 font-mono text-base font-semibold text-zinc-100 hover:text-white">
          <span class="text-brand">~/</span>adam.log
        </.link>

        <nav class="flex flex-wrap items-center gap-2 text-sm">
          <.link navigate={~p"/"} class="nav-link">Home</.link>
          <.link navigate={~p"/posts"} class="nav-link">Posts</.link>
          <.link navigate={~p"/search"} class="nav-link">Search</.link>
          <.link navigate={~p"/tags/search"} class="nav-link">Tags</.link>

          <%= if assigns[:current_user] do %>
            <.link href={~p"/notifications"} class="nav-link relative">
              Notifications
              <%= if (count = Blog.Notifications.unread_count(@current_user.id)) > 0 do %>
                <span class="absolute -top-1 -right-1 flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-brand px-1 text-[10px] font-bold leading-none text-zinc-950">
                  {count}
                </span>
              <% end %>
            </.link>
          <% end %>

          <%= if @current_user && @current_user.admin do %>
            <span class="mx-1 h-4 w-px bg-zinc-800" aria-hidden="true"></span>
            <.link navigate={~p"/posts/new"} class="nav-link-accent">New Post</.link>
            <.link navigate={~p"/tags/new"} class="nav-link-accent">New Tag</.link>
          <% end %>

          <span class="mx-1 h-4 w-px bg-zinc-800" aria-hidden="true"></span>

          <%= if @current_user do %>
            <span class="hidden font-mono text-xs text-zinc-500 sm:inline">{@current_user.email}</span>
            <.link href={~p"/users/settings"} class="nav-link">Settings</.link>
            <.link href={~p"/users/log_out"} method="delete" class="nav-link">Log out</.link>
          <% else %>
            <.link href={~p"/users/register"} class="nav-link">Register</.link>
            <.link href={~p"/users/log_in"} class="nav-link">Log in</.link>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-none px-4 sm:px-6 lg:px-8 xl:max-w-screen-xl 2xl:max-w-screen-2xl">
      {@inner_content}
    </main>

    <footer class="mt-16 border-t border-zinc-800/80 py-8">
      <div class="mx-auto flex w-full max-w-none flex-col items-center gap-2 px-4 text-center font-mono text-xs text-zinc-600 sm:px-6 lg:px-8 xl:max-w-screen-xl 2xl:max-w-screen-2xl">
        <p>Built with Elixir &amp; Phoenix.</p>
        <a href="https://github.com/adamvietro" target="_blank" rel="noopener" class="hover:text-brand">
          github.com/adamvietro
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav-link {
    @apply rounded-md px-3 py-1.5 text-zinc-400 transition-colors hover:bg-zinc-800/60 hover:text-zinc-100;
  }

  .nav-link-accent {
    @apply rounded-md border border-brand/40 px-2.5 py-1.5 text-brand transition-colors hover:bg-brand/10;
  }
</style>
